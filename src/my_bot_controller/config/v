      move:
        type: topic
        interface_type: geometry_msgs/msg/TwistStamped
        topic_name: my_bot_controller/cmd_vel

      deadman_buttons: [5]

      axis_mapping:
        twist-linear-x:
          axis: 1
          scale: 1.0
          offset: 0.0
        twist-angular-z:
          axis: 3